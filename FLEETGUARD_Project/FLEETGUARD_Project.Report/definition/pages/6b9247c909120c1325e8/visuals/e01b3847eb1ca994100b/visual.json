      "visualHeaderTooltip": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Compares fuel and mileage benchmark assessment coverage for each vehicle.\n\nFuel Assessment Coverage is the percentage of trips with a valid fuel consumption benchmark based on comparable trips performed by other drivers using the same vehicle and route pair.\n\nMileage Assessment Coverage is the percentage of trips with a valid distance benchmark based on comparable trips performed by other drivers on the same route pair, regardless of vehicle.\n\nBoth benchmarks require at least 20 comparable trips from at least two other drivers.\n\nGeneric destinations are excluded from mileage benchmark assessment.\n\nA low assessment coverage indicates insufficient reference data, not necessarily low risk or correct trip records.'"
                }
              }
            }
          }
        }
      ]
