      "visualHeaderTooltip": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Compares actual and expected fuel consumption for each vehicle, expressed in L/100KM.\nActual Fuel Consumption: Distance-weighted average consumption calculated from trips with a valid peer benchmark.\nPeer Fuel Benchmark: Distance-weighted average of trip-level benchmarks based on median consumption by other drivers using the same vehicle and route pair.\nA valid benchmark requires at least 20 comparable trips from at least two other drivers.\nBoth values are calculated using the same assessed trips. Vehicles without valid benchmarks are excluded.\nBenchmarks are based on the full historical dataset. Higher actual consumption indicates a deviation requiring further review, not confirmed fraud.'"
                }
              }
            },
            "themedTitleFontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#94A3B8'"
                    }
                  }
                }
              }
            },
            "themedBackground": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#243247'"
                    }
                  }
                }
              }
            }
          }
        }
