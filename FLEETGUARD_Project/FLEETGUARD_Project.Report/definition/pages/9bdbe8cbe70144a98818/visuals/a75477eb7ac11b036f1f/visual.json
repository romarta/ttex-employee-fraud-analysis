      "visualHeaderTooltip": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Shows the monthly distribution of estimated financial exposure associated with flagged fuel consumption trips.\n\nFinancial exposure is calculated as estimated excess fuel multiplied by the selected fuel price scenario (PLN/L).\n\nEach trip is assigned to a month based on its recorded start date.\n\nPeer benchmarks are based on the full historical dataset, while the selected fuel price is a scenario assumption applied to all included trips.\n\nThe results represent model-based estimates, not confirmed financial losses. Missing reporting periods should not be interpreted as zero exposure without verifying data completeness.'"
                }
              }
            },
            "themedTitleFontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#94A3B8'"
                    }
                  }
                }
              }
            },
