	partition DimDepartment = m
		mode: import
		source =
				let
				    Zrodlo = Pliki_Baza,
				
				    Filtrowanie = Table.SelectRows(
				        Zrodlo,
				        each [Nazwa_arkusza] = "Department"
				    ),
				
				    Tabele = Filtrowanie[Dane_przygotowane],
				
				    Polaczone = Table.Combine(Tabele),
				    #"Usunięto duplikaty" = Table.Distinct(Polaczone),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Usunięto duplikaty",{{"id", Int64.Type}, {"name", type text}, {"description", type text}})
				
				in
				    #"Zmieniono typ"

	annotation PBI_NavigationStepName = Nawigacja

	annotation PBI_ResultType = Table

