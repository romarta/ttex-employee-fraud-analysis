	partition DimEmployee = m
		mode: import
		source =
				let
				    Zrodlo = Pliki_Baza,
				
				    Filtrowanie = Table.SelectRows(
				        Zrodlo,
				        each [Nazwa_arkusza] = "Employee"
				    ),
				
				    Tabele = Filtrowanie[Dane_przygotowane],
				
				    Polaczone = Table.Combine(Tabele),
				    #"Usunięto duplikaty" = Table.Distinct(Polaczone),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Usunięto duplikaty",{{"id", Int64.Type}, {"name", type text}, {"surname", type text}, {"gender", type text}, {"department", Int64.Type}, {"position", Int64.Type}, {"year_of_birth", Int64.Type}, {"date_of_employment", type date}, {"employment_end_date", type date}}),
				    #"Usunięto puste wiersze" = Table.SelectRows(#"Zmieniono typ", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
				    #"Zmieniono nazwy kolumn" = Table.RenameColumns(#"Usunięto puste wiersze",{{"department", "department_id"}, {"position", "position_id"}})
				
				in
				    #"Zmieniono nazwy kolumn"

	annotation PBI_NavigationStepName = Nawigacja

	annotation PBI_ResultType = Table

