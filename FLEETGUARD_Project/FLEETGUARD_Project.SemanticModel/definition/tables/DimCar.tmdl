	column 'Vehicle Label' =
			
			DimCar[brand] & " " &
			DimCar[model] & " (" &
			FORMAT(DimCar[year], "0") & ")" &
			" | ID " & FORMAT(DimCar[id], "0")
		lineageTag: 732854ba-8091-4c64-b3c5-8c45e0e06662
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimCar = m
		mode: import
		source =
				let
				    Zrodlo = Pliki_Baza,
				
				    Filtrowanie = Table.SelectRows(
				        Zrodlo,
				        each [Nazwa_arkusza] = "Car"
				    ),
				
				    Tabele = Filtrowanie[Dane_przygotowane],
				
				    Polaczone = Table.Combine(Tabele),
				    #"Usunięto duplikaty" = Table.Distinct(Polaczone),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Usunięto duplikaty",{{"id", Int64.Type}, {"brand", type text}, {"model", type text}, {"year", Int64.Type}, {"fuel_type", type text}, {"transport", type text}, {"active", type text}, {"active_from", type date}, {"active_to", type date}}),
				    #"Zamieniono wartość" = Table.ReplaceValue(#"Zmieniono typ",null,"Yes",Replacer.ReplaceValue,{"active"})
				
				in
				    #"Zamieniono wartość"

	annotation PBI_NavigationStepName = Nawigacja

	annotation PBI_ResultType = Table

