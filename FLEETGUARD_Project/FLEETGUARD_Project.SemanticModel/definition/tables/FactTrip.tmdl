	column FuelConsumptionBin
		dataType: int64
		formatString: 0
		lineageTag: f5950811-7232-46bd-80f4-34e189c729bf
		summarizeBy: sum
		sourceColumn: FuelConsumptionBin

		annotation SummarizationSetBy = Automatic

	column PeerFuelBenchmarkTrip =
			
			VAR CurrentCar =
			    FactTrip[car_id]
			
			VAR CurrentEmployee =
			    FactTrip[employee_id]
			
			VAR CurrentRoute =
			    RELATED(DimRoute[RoutePairKey])
			
			VAR PeerRows =
			    FILTER(
			        ALL(FactTrip),
			        FactTrip[car_id] = CurrentCar
			            && FactTrip[employee_id] <> CurrentEmployee
			            && RELATED(DimRoute[RoutePairKey]) = CurrentRoute
			            && NOT ISBLANK(FactTrip[FuelPer100KM])
			    )
			
			VAR PeerTripCount =
			    COUNTROWS(PeerRows)
			
			VAR PeerDriverCount =
			    COUNTROWS(
			        SUMMARIZE(
			            PeerRows,
			            FactTrip[employee_id]
			        )
			    )
			
			VAR Benchmark =
			    MEDIANX(
			        PeerRows,
			        FactTrip[FuelPer100KM]
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(CurrentRoute)
			        && PeerTripCount >= 20
			        && PeerDriverCount >= 2,
			    Benchmark,
			    BLANK()
			)
		formatString: 0.00
		lineageTag: fd58a332-8d43-4093-8f38-52a1887d530d
		summarizeBy: none

		annotation SummarizationSetBy = User

	column FuelDeviationPct =
			
			VAR ActualFuel =
			    FactTrip[FuelPer100KM]
			
			VAR Benchmark =
			    FactTrip[PeerFuelBenchmarkTrip]
			
			RETURN
			IF(
			    ISBLANK(ActualFuel)
			        || ISBLANK(Benchmark)
			        || Benchmark <= 0,
			    BLANK(),
			    DIVIDE(
			        ActualFuel - Benchmark,
			        Benchmark
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7c76de44-e1ae-40ca-ac61-eb9c410d4271
		summarizeBy: none

		annotation SummarizationSetBy = User

	column FuelRiskCategory =
			
			VAR Deviation =
			    FactTrip[FuelDeviationPct]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ISBLANK(Deviation),
			        "Insufficient Reference Data",
			
			    Deviation >= 1,
			        "Very High Anomaly",
			
			    Deviation >= 0.5,
			        "High Anomaly",
			
			    Deviation >= 0.25,
			        "Elevated Consumption",
			
			    "Within Expected Range"
			)
		lineageTag: a9147e2a-a632-483f-80a3-78458a21269d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FuelAnomalyFlag =
			
			VAR Deviation =
			    FactTrip[FuelDeviationPct]
			
			RETURN
			IF(
			    ISBLANK(Deviation),
			    BLANK(),
			    IF(
			        Deviation >= 0.5,
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: db9a7e4e-b6a5-468b-99c2-366bd178ec16
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Trip Label' =
			
			"TRIP-" & FORMAT(FactTrip[id], "0000")
		lineageTag: d3f7a4f0-d619-444a-92c2-2b07d3d686d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fuel Consumption Range' =
			
			VAR BinStart =
			    FactTrip[FuelConsumptionBin]
			
			RETURN
			IF(
			    ISBLANK(BinStart),
			    BLANK(),
			    FORMAT(BinStart, "0")
			        & "–"
			        & FORMAT(BinStart + 2, "0")
			)
		lineageTag: 6e9a16c5-655d-40ff-9432-69b6094f9514
		summarizeBy: none
		sortByColumn: FuelConsumptionBin

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column PeerDistanceBenchmarkTrip =
			
			VAR CurrentRoutePair =
			    RELATED(DimRoute[RoutePairKey])
			
			VAR CurrentEmployee =
			    FactTrip[employee_id]
			
			VAR IsEligibleRoute =
			    RELATED(DimRoute[Distance Reference Status])
			        = "City Pair"
			
			VAR ComparableTrips =
			    FILTER(
			        ALL(FactTrip),
			        FactTrip[distance] > 0
			            && FactTrip[employee_id] <> CurrentEmployee
			            && RELATED(DimRoute[RoutePairKey])
			                = CurrentRoutePair
			    )
			
			VAR PeerTripCount =
			    COUNTROWS(ComparableTrips)
			
			VAR PeerDriverCount =
			    COUNTROWS(
			        SUMMARIZE(
			            ComparableTrips,
			            FactTrip[employee_id]
			        )
			    )
			
			VAR BenchmarkDistance =
			    CONVERT(
			        MEDIANX(
			            ComparableTrips,
			            FactTrip[distance]
			        ),
			        DOUBLE
			    )
			
			RETURN
			IF(
			    IsEligibleRoute
			        && PeerTripCount >= 20
			        && PeerDriverCount >= 2,
			    BenchmarkDistance,
			    BLANK()
			)
		formatString: 0.0
		lineageTag: 560e3db9-06f0-4a59-98dd-cbe56946ebce
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MileageDeviationPct =
			
			VAR ActualDistance =
			    FactTrip[distance]
			
			VAR BenchmarkDistance =
			    FactTrip[PeerDistanceBenchmarkTrip]
			
			RETURN
			IF(
			    ISBLANK(BenchmarkDistance)
			        || BenchmarkDistance <= 0,
			    BLANK(),
			    DIVIDE(
			        ActualDistance - BenchmarkDistance,
			        BenchmarkDistance
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e686326d-bfb0-4e8f-a0a1-58015411563b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

