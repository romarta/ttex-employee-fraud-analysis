				    #"Zamieniono wartość11" = Table.ReplaceValue(#"Zamieniono wartość10","Warsawa","Warszawa",Replacer.ReplaceValue,{"to"}),
				    #"Zamieniono wartość12" = Table.ReplaceValue(#"Zamieniono wartość11","Ostruda","Ostróda",Replacer.ReplaceValue,{"to"}),
				    #"Zamieniono wartość13" = Table.ReplaceValue(#"Zamieniono wartość12","Ostroda","Ostróda",Replacer.ReplaceText,{"to"}),
				    #"Zamieniono wartość14" = Table.ReplaceValue(#"Zamieniono wartość13","Ost","Ostróda",Replacer.ReplaceValue,{"to"}),
				    #"Zamieniono wartość15" = Table.ReplaceValue(#"Zamieniono wartość14","Ostruda","Ostróda",Replacer.ReplaceValue,{"from"}),
				    #"Zamieniono wartość16" = Table.ReplaceValue(#"Zamieniono wartość15","Ost","Ostróda",Replacer.ReplaceValue,{"from"}),
				    #"Zamieniono wartość17" = Table.ReplaceValue(#"Zamieniono wartość16","Elblag","Elbląg",Replacer.ReplaceValue,{"from"}),
				    #"Zamieniono wartość18" = Table.ReplaceValue(#"Zamieniono wartość17","Elblag","Elbląg",Replacer.ReplaceValue,{"to"}),
				    #"Zamieniono wartość19" = Table.ReplaceValue(#"Zamieniono wartość18","Byd","Bydgoszcz",Replacer.ReplaceValue,{"to"}),
