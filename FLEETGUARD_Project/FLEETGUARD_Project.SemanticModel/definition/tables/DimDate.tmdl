	hierarchy 'Year Hierarchia'
		lineageTag: 34969fa0-c3fc-4ecd-8e7a-bde1953886a6

		level Year
			lineageTag: 14b4e73b-d851-4fdf-89a9-9ec250f03002
			column: Year

		level Quarter
			lineageTag: ddb42167-a4b4-47d1-8f25-18e56012941b
			column: Quarter

		level Month
			lineageTag: c21bc5d2-16bf-47fb-981e-3c1903a5df21
			column: Month

		level Date
			lineageTag: 4f8297ae-0d87-47a6-b833-183d61ab68ef
			column: Date

	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(MIN(FactTrip[start])), 1, 1),
				        DATE(YEAR(MAX(FactTrip[end])), 12, 31)
				    ),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMMM", "en-US"),
				    "Month Short", FORMAT([Date], "MMM", "en-US"),
				    "Year-Month", FORMAT([Date], "yyyy-MM"),
				    "Week Number", WEEKNUM([Date], 2),
				    "Day", DAY([Date]),
				    "Day of Week Number", WEEKDAY([Date], 2),
				    "Day of Week", FORMAT([Date], "dddd", "en-US"),
				    "Day of Week Short", FORMAT([Date], "ddd", "en-US"),
				    "Day Type",
				        IF(
				            WEEKDAY([Date], 2) >= 6,
				            "Weekend",
				            "Weekday"
				        )
				)

	annotation PBI_Id = 4a90906a6b344d10907dcde0955ff840

