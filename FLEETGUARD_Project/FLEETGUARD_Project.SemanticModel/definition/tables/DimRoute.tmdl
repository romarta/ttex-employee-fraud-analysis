		summarizeBy: none
		sourceColumn: RoutePairKey

		annotation SummarizationSetBy = Automatic

	column 'Distance Reference Status' =
			
			VAR OriginLocation =
			    LOWER(
			        TRIM(DimRoute[Origin])
			    )
			
			VAR DestinationLocation =
			    LOWER(
			        TRIM(DimRoute[Destination])
			    )
			
			VAR IsGenericLocation =
			    OriginLocation IN {"sklep", "urząd"}
			        || DestinationLocation IN {"sklep", "urząd"}
			
			RETURN
			IF(
			    IsGenericLocation,
			    "Generic Location",
			    "City Pair"
			)
		lineageTag: 057d6688-899c-43e9-bdd0-5cac5de5a7f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimRoute = m
		mode: import
		source =
				let
				    Źródło = FactTrip,
				    #"Usunięto inne kolumny" = Table.SelectColumns(Źródło,{"from", "to", "RouteKey"}),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Usunięto inne kolumny",{{"RouteKey", type text}}),
				    #"Usunięto duplikaty" = Table.Distinct(#"Zmieniono typ", {"RouteKey"}),
				    #"Dodano kolumnę niestandardową" = Table.AddColumn(#"Usunięto duplikaty", "RouteName", each if [Origin] = null or [Destination] = null then
				    null
				else
				    [Origin] & " → " & [Destination]),
				    #"Zmieniono nazwy kolumn" = Table.RenameColumns(#"Dodano kolumnę niestandardową",{{"from", "Origin"}, {"to", "Destination"}}),
				    #"Usunięto kolumny" = Table.RemoveColumns(#"Zmieniono nazwy kolumn",{"RouteName"}),
				    #"Dodano kolumnę niestandardową1" = Table.AddColumn(#"Usunięto kolumny", "RouteName", each if [Origin] = null or [Destination] = null then
				    null
				else
				    [Origin] & " → " & [Destination]),
				    #"Dodano kolumnę niestandardową2" = Table.AddColumn(#"Dodano kolumnę niestandardową1", "RoutePairKey", each if [Origin] = null or [Destination] = null then
				    null
				else
				    Text.Combine(
				        List.Sort(
				            {[Origin], [Destination]},
				            Comparer.OrdinalIgnoreCase
				        ),
				        " | "
				    )),
				    #"Zmieniono typ1" = Table.TransformColumnTypes(#"Dodano kolumnę niestandardową2",{{"RoutePairKey", type text}, {"RouteName", type text}})
				in
				    #"Zmieniono typ1"

	annotation PBI_NavigationStepName = Nawigacja

	annotation PBI_ResultType = Table

